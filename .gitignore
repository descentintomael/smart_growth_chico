# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# Local API response cache (Google Places etc.) — keep out of git
.cache/
# OSMnx default cache (in case the script's setting isn't applied early enough)
cache/

# Testing
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript cache
*.tsbuildinfo

# PersonaSpec test results
test-results/
*.observations.json

# Local session notes — not for a public repo
docs/session-logs/

# Local working files and source evidence — not for a public repo
scratchpad/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
__pycache__/

# Local issue-tracker state — never tracked
.beads/
